# ---- Which models to use ---------------------------------------------------
# LLM_PROVIDER: openai | anthropic | gemini | groq | ollama
LLM_PROVIDER=groq
# Optional: override the provider's default chat model
# LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0

# EMBEDDING_PROVIDER: openai | gemini | ollama   (Anthropic/Groq have no embeddings)
EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=nomic-embed-text

# ---- API keys (only the ones for your chosen providers are needed) -------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ---- Qdrant -----------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documind_chunks

# ---- Ingestion ---------------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
EMBED_BATCH_SIZE=32

# ---- Retrieval / answering --------------------------------------------------
# RETRIEVAL_MODE: dense | bm25 | hybrid
RETRIEVAL_MODE=hybrid
TOP_K=5
CANDIDATE_K=20
MIN_RELEVANCE_SCORE=0.25
ENABLE_RERANK=false

# ---- API ----------------------------------------------------------------------
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
